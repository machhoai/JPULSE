{
  "name": "@bduck/zalo-mini-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:zalo-testing": "tsc --noEmit && vite build --mode zalo-testing --outDir dist/zalo-testing && node scripts/prepare-zalo-testing.mjs",
    "build:zalo-production": "tsc --noEmit && vite build --mode zalo-production --outDir dist/zalo-production && node scripts/prepare-zalo-testing.mjs dist/zalo-production",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "lucide-react": "1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.1.2",
    "zmp-sdk": "2.53.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.0",
    "typescript": "^5.7.0",
    "vite": "8.3.4"
  }
}
